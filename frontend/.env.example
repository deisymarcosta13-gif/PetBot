# Copia este archivo como .env para desarrollo local.
# En Vercel, define la variable en Settings → Environment Variables.

# URL del backend, sin "/" final.
# Desarrollo:  VITE_API_URL=http://127.0.0.1:8000
# Producción:  VITE_API_URL=https://TU-BACKEND.onrender.com
VITE_API_URL=http://127.0.0.1:8000
