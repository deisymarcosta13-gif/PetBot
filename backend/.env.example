# Copia este archivo como .env para desarrollo local.
# En Render, define estas variables en Environment (no subas el .env real).

# Conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:5432/NOMBRE_BD
# (si el proveedor entrega postgres://, el backend lo convierte automáticamente)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/petbot

# Clave para firmar los JWT.
# En producción usa una clave aleatoria fuerte y distinta a la de desarrollo, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave

# Algoritmo de firma de los JWT
ALGORITHM=HS256

# Duración del token en minutos (1440 = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API key de Google Gemini
GEMINI_API_KEY=tu-api-key-de-gemini

# Orígenes permitidos por CORS, separados por comas y sin "/" final.
# Si no se define, se permiten solo http://localhost:5173 y http://127.0.0.1:5173
# Producción: añade la URL de Vercel, por ejemplo:
#   CORS_ORIGINS=https://tu-proyecto.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
